;;; memory--store.el --- Durable log and summary tree -*- lexical-binding: t -*-
(require 'cl-lib)
(require 'json)
(require 'subr-x)
(require 'memory-context)
(declare-function memory--notify "memory" (memory event))

(defvar memory--message-bytes 30000)
(defvar memory--log-context-id nil
  "Exact model invocation responsible for the current presentation.")
(defvar memory--view-high 128000)
(defvar memory--view-low 64000)
(defvar memory--compaction-high 32000)
(defvar memory--compaction-low 16000)
(defvar memory--page-bytes 4000)
(defvar memory--kinds nil)
(defvar memory--result-kind "echo")
(defvar memory--presentation-function nil)

(cl-defstruct (memory--queue (:constructor memory--queue-create)) head tail (count 0))
(defun memory--enqueue (queue value)
  (let ((cell (list value)))
    (if (memory--queue-tail queue)
        (setcdr (memory--queue-tail queue) cell)
      (setf (memory--queue-head queue) cell))
    (setf (memory--queue-tail queue) cell)
    (cl-incf (memory--queue-count queue))))
(defun memory--queue-front (queue value)
  (let ((cell (cons value (memory--queue-head queue))))
    (setf (memory--queue-head queue) cell)
    (unless (memory--queue-tail queue) (setf (memory--queue-tail queue) cell))
    (cl-incf (memory--queue-count queue))))
(defun memory--dequeue (queue)
  (when (memory--queue-head queue) (cl-decf (memory--queue-count queue)))
  (prog1 (pop (memory--queue-head queue))
    (unless (memory--queue-head queue) (setf (memory--queue-tail queue) nil))))

(cl-defstruct (memory--state (:constructor memory--state-create))
  directory lock (count 0) messages nodes (cursor 0) view comp-view
  batching comp-batching jobs leaves (leaf-slots 0) states failed (active 0) closed
  backend policy ledger diagnostics running streams subscribers (sequence 0) (job-sequence 0) pending-events notifying scheduling)

(defun memory--bytes (text) (length (encode-coding-string text 'utf-8-unix)))
(defun memory--split (text limit)
  "Split TEXT without losing characters, at most LIMIT UTF-8 bytes per part."
  (when (< limit 4) (error "UTF-8 chunk limit must be at least four"))
  (let ((start 0) (size 0) pieces)
    (dotimes (i (length text))
      (let ((width (memory--bytes (substring text i (1+ i)))))
        (when (> (+ size width) limit)
          (push (substring text start i) pieces) (setq start i size 0))
        (cl-incf size width)))
    (push (substring text start) pieces)
    (nreverse pieces)))
(defun memory--clip (text)
  (if (<= (length text) 30000) text
    (concat (substring text 0 15000) (substring text -15000))))

(defun memory--json-read (text)
  (json-parse-string text :object-type 'plist :array-type 'list
                     :null-object nil :false-object nil))
(defun memory--write (file text &optional append)
  (let ((coding-system-for-write 'utf-8-unix)
        (write-region-inhibit-fsync nil))
    (with-temp-buffer
      (insert text) (write-region (point-min) (point-max) file append 'silent))))
(defun memory--atomic (file value)
  (let ((temp (make-temp-file (concat file ".tmp-"))))
    (unwind-protect
        (progn (memory--write temp (concat (json-serialize value) "\n"))
               (rename-file temp file t))
      (when (file-exists-p temp) (delete-file temp)))))
(defun memory--recover-record-tail (file)
  "Discard only an incomplete last record, preserving its bytes in a side file."
  (with-temp-buffer
    (set-buffer-multibyte nil) (insert-file-contents-literally file)
    (unless (or (= (buffer-size) 0) (eq (char-before (point-max)) ?\n))
      (goto-char (point-max))
      (let* ((end (if (search-backward "\n" nil t) (1+ (point)) (point-min)))
             (size (1- end)) (tail (buffer-substring end (point-max)))
             (backup (make-temp-file (concat file ".incomplete-"))))
        (let ((coding-system-for-write 'no-conversion) (write-region-inhibit-fsync nil))
          (write-region tail nil backup nil 'silent))
        (unless (and (executable-find "truncate")
                     (= (call-process "truncate" nil nil nil "--size" (number-to-string size) file) 0))
          (error "Cannot recover incomplete tail in %s; copied to %s" file backup))
        (message "SlopChat recovered incomplete record in %s; partial bytes saved in %s" file backup)))))
(defun memory--records (directory consume)
  (dolist (file (sort (directory-files directory t "\\.jsonl\\'") #'string<))
    (memory--recover-record-tail file)
    (with-temp-buffer
      (let ((coding-system-for-read 'utf-8-unix)) (insert-file-contents file))
      (unless (or (= (point-min) (point-max)) (eq (char-before (point-max)) ?\n))
        (error "Incomplete final log record in %s; existing complete records are preserved" file))
      (goto-char (point-min))
      (while (< (point) (point-max))
        (let ((line (buffer-substring-no-properties (point) (line-end-position))))
          (condition-case err (funcall consume (memory--json-read line))
            (error (error "Invalid log record in %s line %s: %s"
                          file (line-number-at-pos) (error-message-string err)))))
        (forward-line 1)))))
(defun memory--lock (chat)
  "Hold a kernel flock through a pipe-owned helper; crashes release it."
  (unless (executable-find "flock") (error "Chat locking requires flock"))
  (let* ((buffer (generate-new-buffer " *memory--lock*"))
         (lock (make-process
                :name "memory--lock" :buffer buffer :connection-type 'pipe
                :command (list "flock" "--close" "--nonblock" "--conflict-exit-code" "75"
                               (expand-file-name ".lock" (memory--state-directory chat))
                               "sh" "-c" "printf 'locked\\n'; cat >/dev/null")
                :noquery t))
         (deadline (+ (float-time) 5)))
    (setf (memory--state-lock chat) lock)
    (while (and (process-live-p lock)
                (with-current-buffer buffer (= (buffer-size) 0))
                (< (float-time) deadline))
      (accept-process-output lock 0.05))
    (unless (and (process-live-p lock)
                 (with-current-buffer buffer (string-prefix-p "locked\n" (buffer-string))))
      (delete-process lock) (kill-buffer buffer)
      (error "Chat is locked or flock failed: %s" (memory--state-directory chat)))))

(defun memory--key (level index) (list level index))
(defun memory--node (chat key) (gethash key (memory--state-nodes chat)))
(defun memory--range (key)
  (let ((span (ash 1 (car key)))) (cons (* span (cadr key)) span)))
(defun memory--line (chat key)
  (let* ((node (memory--node chat key)) (range (memory--range key)))
    (unless node (error "Unbuilt node: %S" key))
    (format "%d+%d|%s\n" (car range) (cdr range)
            (replace-regexp-in-string "[\r\n]+" " " (plist-get node :text)))))
(cl-defun memory--render (chat &optional (view nil supplied))
  (concat "<chat>\n" (mapconcat (lambda (key) (memory--line chat key))
                              (if supplied view (memory--state-view chat)) "") "</chat>"))
(defun memory--view-size (chat view)
  (+ (memory--bytes "<chat>\n</chat>")
     (cl-loop for key in view sum (memory--bytes (memory--line chat key)))))

(defun memory--best-merge (view total &optional available)
  "Return the cell whose first two sibling entries are most due.
Compare integer cross-products; TOTAL is the number of logged messages."
  (let ((cell view) best best-age best-span best-first)
    (while (cdr cell)
      (let* ((a (car cell)) (b (cadr cell)) (level (car a))
             (index (cadr a)) (span (ash 1 level))
             (parent (list (1+ level) (/ index 2))))
        (when (and (= level (car b)) (= (cadr b) (1+ index))
                   (= (% index 2) 0) (or (null available) (funcall available parent)))
          (let* ((first (* index span)) (age (- total (+ first (* 2 span) -1))))
            (when (or (null best)
                      (> (* age best-span) (* best-age span))
                      (and (= (* age best-span) (* best-age span)) (< first best-first)))
              (setq best cell best-age age best-span span best-first first)))))
      (setq cell (cdr cell)))
    best))
(defun memory--merge-to (chat view low &optional line-budget)
  "Merge VIEW in place until LOW bytes (or test LINE-BUDGET), if possible."
  (let ((size (memory--view-size chat view)) candidate)
    (while (and (if line-budget (> (length view) line-budget) (> size low))
                (setq candidate
                      (memory--best-merge
                       view (memory--state-count chat)
                       (lambda (parent) (memory--node chat parent)))))
      (let* ((a (car candidate)) (b (cadr candidate))
             (parent (list (1+ (car a)) (/ (cadr a) 2))))
        (cl-incf size (- (memory--bytes (memory--line chat parent))
                        (memory--bytes (memory--line chat a))
                        (memory--bytes (memory--line chat b))))
        (setcar candidate parent) (setcdr candidate (cddr candidate))))
    view))
(defun memory--shrink (chat)
  (when (> (memory--view-size chat (memory--state-view chat)) memory--view-high)
    (setf (memory--state-batching chat) t))
  (when (memory--state-batching chat)
    (let ((before (copy-tree (memory--state-view chat))))
      (setf (memory--state-view chat)
            (memory--merge-to chat (memory--state-view chat) memory--view-low))
      (unless (equal before (memory--state-view chat))
        (setf (memory--state-comp-batching chat) t)))
    (when (<= (memory--view-size chat (memory--state-view chat)) memory--view-low)
      (setf (memory--state-batching chat) nil)))
  (when (> (memory--view-size chat (memory--state-comp-view chat)) memory--compaction-high)
    (setf (memory--state-comp-batching chat) t))
  (when (memory--state-comp-batching chat)
    (setf (memory--state-comp-view chat)
          (memory--merge-to chat (memory--state-comp-view chat) memory--compaction-low))
    (when (<= (memory--view-size chat (memory--state-comp-view chat)) memory--compaction-low)
      (setf (memory--state-comp-batching chat) nil))))
(defun memory--checkpoint (chat)
  "Atomically persist view and its contiguous-log cursor in one file."
  (memory--atomic
   (expand-file-name "view.json" (memory--state-directory chat))
   `(:version 1 :cursor ,(memory--state-cursor chat)
     :view ,(vconcat (mapcar #'vconcat (memory--state-view chat)))
     :compactionView ,(vconcat (mapcar #'vconcat (memory--state-comp-view chat)))
     :batching ,(if (memory--state-batching chat) t :false)
     :compactionBatching ,(if (memory--state-comp-batching chat) t :false))))
(defun memory--publish (chat)
  (let ((old-view (copy-tree (memory--state-view chat)))
        (old-cursor (memory--state-cursor chat)))
  (while (memory--node chat (list 0 (memory--state-cursor chat)))
    (let ((key (list 0 (memory--state-cursor chat))))
      (setf (memory--state-view chat) (nconc (memory--state-view chat) (list key))
            (memory--state-comp-view chat) (nconc (memory--state-comp-view chat) (list key)))
      (cl-incf (memory--state-cursor chat))))
  (memory--shrink chat)
  (memory--checkpoint chat)
  (unless (and (equal old-view (memory--state-view chat)) (= old-cursor (memory--state-cursor chat)))
    (memory--notify chat (list :kind 'view-published :cursor (memory--state-cursor chat)
                              :view (memory--state-view chat))))))
(defun memory--admit-leaves (chat)
  ;; At most eight unbuilt admitted leaves. Later leaves wait in an O(1) FIFO,
  ;; so scheduling does not scan earlier tree nodes or a growing log.
  (while (and (< (memory--state-leaf-slots chat) 8)
              (memory--queue-head (memory--state-leaves chat)))
    (let ((key (memory--dequeue (memory--state-leaves chat))))
      (cl-incf (memory--state-leaf-slots chat))
      (puthash key 'queued (memory--state-states chat))
      (memory--enqueue (memory--state-jobs chat) key))))
(defun memory--queue-node (chat key)
  (unless (or (memory--node chat key) (gethash key (memory--state-states chat)))
    (if (= (car key) 0)
        (progn (puthash key 'waiting (memory--state-states chat))
               (memory--enqueue (memory--state-leaves chat) key)
               (memory--admit-leaves chat))
      (puthash key 'queued (memory--state-states chat))
      (memory--enqueue (memory--state-jobs chat) key))))

(defun memory--source (chat key)
  (if (= (car key) 0)
      (let ((message (gethash (cadr key) (memory--state-messages chat))))
        (format "%s: %s" (plist-get message :kind) (plist-get message :text)))
    (let* ((level (1- (car key))) (index (* 2 (cadr key)))
           (a (memory--node chat (list level index)))
           (b (memory--node chat (list level (1+ index)))))
      (when (and a b) (concat (plist-get a :text) "\n" (plist-get b :text))))))
(defun memory--offer (chat key)
  (let ((source (memory--source chat key)))
    (when source
      (if (<= (memory--bytes source) 512) (memory--build chat key source)
        (memory--queue-node chat key)))))
(defun memory--build (chat key text)
  "Commit an immutable node, then offer its newly ready parent."
  (unless (memory--node chat key)
    (let* ((node `(:l ,(car key) :i ,(cadr key) :text ,text :size ,(memory--bytes text)))
           (file (expand-file-name (concat "tree/" (format-time-string "%Y-%m-%d") ".jsonl")
                                   (memory--state-directory chat))))
      (memory--write file (concat (json-serialize node) "\n") t)
      (puthash key node (memory--state-nodes chat))
      (memory--notify chat (list :kind 'node-built :node key :size (plist-get node :size)))
      (when (and (= (car key) 0) (memq (gethash key (memory--state-states chat)) '(queued active failed)))
        (cl-decf (memory--state-leaf-slots chat)))
      (puthash key 'built (memory--state-states chat))
      (memory--admit-leaves chat)
      (memory--offer chat (list (1+ (car key)) (/ (cadr key) 2)))
      (memory--publish chat)))
  (memory--node chat key))
(defun memory--log (chat kind text &optional presentation)
  "Append TEXT losslessly (except clipped echo), returning its message IDs."
  (when (memory--state-closed chat) (error "Chat is closed"))
  ;; Emacs json-serialize returns unibyte UTF-8. Decode before nesting that
  ;; JSON as message text; raw non-ASCII bytes are not valid JSON string values.
  (unless (multibyte-string-p text)
    (setq text (decode-coding-string text 'utf-8-unix)))
  (unless (and (stringp kind) (not (string-empty-p kind)) (or (null memory--kinds) (member kind memory--kinds)))
    (error "Unknown message kind: %s" kind))
  (let ((parts (if (equal kind memory--result-kind) (list (memory--clip text))
                 (memory--split text memory--message-bytes))) ids)
    (when memory--presentation-function
      (setq presentation (funcall memory--presentation-function presentation
                                  (memory--state-count chat) (length parts))))
    (dolist (part parts)
      (let* ((id (memory--state-count chat))
             (date (format-time-string "%Y-%m-%dT%H:%M:%S.%3NZ" nil t))
             (message `(:i ,id :kind ,kind :text ,part :size ,(memory--bytes part) :date ,date
                         ,@(when (or (plist-get presentation :contextId) memory--log-context-id)
                             (list :contextId (or (plist-get presentation :contextId) memory--log-context-id)))
                         ,@(when presentation (list :tool presentation))))
             (file (expand-file-name (concat "main/" (substring date 0 10) ".jsonl")
                                     (memory--state-directory chat))))
        (memory--write file (concat (json-serialize message) "\n") t)
        (puthash id message (memory--state-messages chat))
        (cl-incf (memory--state-count chat)) (push id ids)
        (memory--notify chat (list :kind 'record-appended :id id))
        (dolist (key (memory--state-failed chat))
          (puthash key 'queued (memory--state-states chat))
          (memory--enqueue (memory--state-jobs chat) key))
        (setf (memory--state-failed chat) nil)
        (memory--offer chat (list 0 id))))
    (nreverse ids)))
(defun memory--validate-view (chat view cursor)
  (let ((next 0))
    (dolist (key view)
      (unless (and (= (length key) 2) (natnump (car key)) (natnump (cadr key))
                   (memory--node chat key)) (error "Invalid persisted view node: %S" key))
      (let ((range (memory--range key)))
        (unless (= next (car range)) (error "Noncontiguous persisted view"))
        (cl-incf next (cdr range))))
    (unless (= next cursor) (error "Persisted view cursor mismatch"))))
(defun memory--store-open (directory)
  "Open DIRECTORY exclusively; preserve its checkpoint and recover only its tail."
  (let* ((directory (file-name-as-directory (expand-file-name directory)))
         (chat (memory--state-create
                :directory directory :messages (make-hash-table :test 'eql)
                :nodes (make-hash-table :test 'equal) :states (make-hash-table :test 'equal)
                :jobs (memory--queue-create) :leaves (memory--queue-create))))
    (make-directory directory t)
    (condition-case err
        (progn
          (memory--lock chat)
          (make-directory (expand-file-name "main" directory) t)
          (make-directory (expand-file-name "tree" directory) t)
          (memory--records
           (expand-file-name "main" directory)
           (lambda (message)
             (unless (and (= (plist-get message :i) (memory--state-count chat))
                          (stringp (plist-get message :text))
                          (= (plist-get message :size) (memory--bytes (plist-get message :text)))
                          (and (stringp (plist-get message :kind)) (or (null memory--kinds) (member (plist-get message :kind) memory--kinds)))
                          (stringp (plist-get message :date))) (error "Invalid message"))
             (puthash (plist-get message :i) message (memory--state-messages chat))
             (cl-incf (memory--state-count chat))))
          (memory--records
           (expand-file-name "tree" directory)
           (lambda (node)
             (let* ((key (list (plist-get node :l) (plist-get node :i)))
                    (range (and (natnump (car key)) (natnump (cadr key)) (memory--range key))))
               (unless (and range (<= (+ (car range) (cdr range)) (memory--state-count chat))
                            (stringp (plist-get node :text))
                            (= (plist-get node :size) (memory--bytes (plist-get node :text)))
                            (not (memory--node chat key))) (error "Invalid or duplicate node"))
               (puthash key node (memory--state-nodes chat))
      (memory--notify chat (list :kind 'node-built :node key :size (plist-get node :size)))
               (puthash key 'built (memory--state-states chat)))))
          (let ((file (expand-file-name "view.json" directory)))
            (if (file-exists-p file)
                (let ((checkpoint (with-temp-buffer (insert-file-contents file)
                                                   (memory--json-read (buffer-string)))))
                  (unless (= (plist-get checkpoint :version) 1) (error "Unsupported checkpoint"))
                  (setf (memory--state-cursor chat) (plist-get checkpoint :cursor)
                        (memory--state-view chat) (plist-get checkpoint :view)
                        (memory--state-comp-view chat) (plist-get checkpoint :compactionView)
                        (memory--state-batching chat) (plist-get checkpoint :batching)
                        (memory--state-comp-batching chat) (plist-get checkpoint :compactionBatching))
                  (unless (<= (memory--state-cursor chat) (memory--state-count chat))
                    (error "Checkpoint ahead of log"))
                  (memory--validate-view chat (memory--state-view chat) (memory--state-cursor chat))
                  (memory--validate-view chat (memory--state-comp-view chat) (memory--state-cursor chat)))
              (when (> (memory--state-count chat) 0)
                (error "Existing log has no view checkpoint; refusing to rebuild its view"))
              (memory--checkpoint chat)))
          ;; Rebuild work queues once on startup, not on every message. Older view
          ;; entries are retained; only committed leaves beyond cursor are published.
          (dotimes (i (memory--state-count chat))
            (unless (memory--node chat (list 0 i)) (memory--offer chat (list 0 i))))
          (let (parents)
            (maphash (lambda (key _node) (push (list (1+ (car key)) (/ (cadr key) 2)) parents))
                     (memory--state-nodes chat))
            (dolist (key parents) (unless (memory--node chat key) (memory--offer chat key))))
          (when (< (memory--state-cursor chat) (memory--state-count chat))
            (memory--publish chat))
          chat)
      (error (memory--store-close chat) (signal (car err) (cdr err))))))
(defun memory--store-close (chat)
  "Release this instance's kernel lock; completed writes are already durable."
  (let ((lock (memory--state-lock chat)))
    (when (processp lock)
      (when (process-live-p lock)
        (process-send-eof lock)
        (let ((deadline (+ (float-time) 2)))
          (while (and (process-live-p lock) (< (float-time) deadline))
            (accept-process-output lock 0.05)))
        (when (process-live-p lock) (delete-process lock)))
      (when (buffer-live-p (process-buffer lock)) (kill-buffer (process-buffer lock)))))
  (setf (memory--state-closed chat) t
))

(defun memory--zoom (chat id span &optional page)
  (unless (and (natnump id) (integerp span) (> span 0) (= (logand span (1- span)) 0)
               (= (% id span) 0) (<= (+ id span) (memory--state-count chat)))
    (error "Invalid zoom range: %S+%S" id span))
  (if (= span 1)
      (let* ((message (gethash id (memory--state-messages chat)))
             (parts (memory--split (plist-get message :text) memory--page-bytes))
             (page (or page 0)))
        (unless (and (natnump page) (< page (length parts))) (error "Invalid message page"))
        `(:id ,id :kind ,(plist-get message :kind) :text ,(nth page parts)
              :page ,page :pages ,(length parts) :date ,(plist-get message :date)))
    (let* ((level (let ((n span) (l -1)) (while (> n 1) (setq n (/ n 2) l (1+ l))) l))
           (index (/ id (/ span 2)))
           (a (memory--node chat (list level index)))
           (b (memory--node chat (list level (1+ index)))))
      (unless (and a b) (error "Zoom children are not built"))
      (vector a b))))
(defun memory--date (chat id)
  (let ((message (and (natnump id) (gethash id (memory--state-messages chat)))))
    (unless message (error "Unknown message ID: %S" id))
    (plist-get message :date)))

(provide 'memory-store)
;;; memory--store.el ends here
