;;; slopchat-context.el --- Compatibility names for the shared snapshot library -*- lexical-binding: t -*-
(require 'slopchat-memory-load)
(require 'unii-memory-context)
(defvaralias 'slopchat-context-terminal-limit 'unii-memory-context-terminal-limit)
(defvaralias 'slopchat-context-byte-limit 'unii-memory-context-byte-limit)
(defalias 'slopchat-context-copy 'unii-memory-context-copy)
(defalias 'slopchat-context-prune 'unii-memory-context-prune)
(defalias 'slopchat-context-capture 'unii-memory-context-capture)
(defalias 'slopchat-context-finish 'unii-memory-context-finish)
(defalias 'slopchat-context-get 'unii-memory-context-get)
(defalias 'slopchat-context-event 'unii-memory-context-event)
(defalias 'slopchat-context-store-create 'unii-memory-context-store-create)
(defalias 'slopchat-context-store-p 'unii-memory-context-store-p)
(defalias 'slopchat-context-store-session 'unii-memory-context-store-session)
(defalias 'slopchat-context-store-sequence 'unii-memory-context-store-sequence)
(defalias 'slopchat-context-store-entries 'unii-memory-context-store-entries)
(defalias 'copy-slopchat-context-store 'copy-unii-memory-context-store)
(gv-define-setter slopchat-context-store-session (value store) `(setf (unii-memory-context-store-session ,store) ,value))
(gv-define-setter slopchat-context-store-sequence (value store) `(setf (unii-memory-context-store-sequence ,store) ,value))
(gv-define-setter slopchat-context-store-entries (value store) `(setf (unii-memory-context-store-entries ,store) ,value))
(provide 'slopchat-context)
