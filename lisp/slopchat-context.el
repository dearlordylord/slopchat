;;; slopchat-context.el --- Compatibility names for the shared snapshot library -*- lexical-binding: t -*-
(require 'memory-context)
(defvaralias 'slopchat-context-terminal-limit 'memory-context-terminal-limit)
(defvaralias 'slopchat-context-byte-limit 'memory-context-byte-limit)
(defalias 'slopchat-context-copy 'memory-context-copy)
(defalias 'slopchat-context-prune 'memory-context-prune)
(defalias 'slopchat-context-capture 'memory-context-capture)
(defalias 'slopchat-context-finish 'memory-context-finish)
(defalias 'slopchat-context-get 'memory-context-get)
(defalias 'slopchat-context-event 'memory-context-event)
(defalias 'slopchat-context-store-create 'memory-context-store-create)
(defalias 'slopchat-context-store-p 'memory-context-store-p)
(defalias 'slopchat-context-store-session 'memory-context-store-session)
(defalias 'slopchat-context-store-sequence 'memory-context-store-sequence)
(defalias 'slopchat-context-store-entries 'memory-context-store-entries)
(defalias 'copy-slopchat-context-store 'copy-memory-context-store)
(gv-define-setter slopchat-context-store-session (value store) `(setf (memory-context-store-session ,store) ,value))
(gv-define-setter slopchat-context-store-sequence (value store) `(setf (memory-context-store-sequence ,store) ,value))
(gv-define-setter slopchat-context-store-entries (value store) `(setf (memory-context-store-entries ,store) ,value))
(provide 'slopchat-context)
