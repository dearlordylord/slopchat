;;; memory-context.el --- Session-only request snapshots -*- lexical-binding: t -*-
(require 'cl-lib)
(defvar memory-context-terminal-limit 100)
(defvar memory-context-byte-limit (* 32 1024 1024))
(cl-defstruct (memory-context-store (:constructor memory-context-store-create))
  (session (format "%s-%s-%s" (emacs-pid) (float-time) (random most-positive-fixnum))) (sequence 0) entries)
(defun memory-context-copy (value)
  "Copy mutable payload containers, including strings and hash tables."
  (cond ((stringp value) (copy-sequence value))
        ((consp value) (cons (memory-context-copy (car value))
                            (memory-context-copy (cdr value))))
        ((vectorp value) (apply #'vector (mapcar #'memory-context-copy value)))
        ((hash-table-p value)
         (let ((copy (make-hash-table :test (hash-table-test value))))
           (maphash (lambda (key item)

                      (puthash (memory-context-copy key) (memory-context-copy item) copy)) value)
           copy))
        (t value)))
(defun memory-context-prune (store)
  "Evict oldest terminal entries; never truncate or evict active input."
  (let ((terminal (cl-remove-if-not (lambda (e) (plist-get e :terminal))
                                    (memory-context-store-entries store))))
    (while (and terminal
                (or (> (length terminal) memory-context-terminal-limit)
                    (> (cl-loop for e in (memory-context-store-entries store)
                                sum (plist-get e :bytes)) memory-context-byte-limit)))
      (let ((oldest (car (last terminal))))
        (setf (memory-context-store-entries store)
              (delq oldest (memory-context-store-entries store)))
        (setq terminal (delq oldest terminal))))))
(defun memory-context-capture (store payload &optional provenance)
  "Capture exact local input independently of canonical memory."
  (let* ((data (memory-context-copy (list :payload payload :provenance provenance)))
         (id (format "%s:%s" (memory-context-store-session store) (cl-incf (memory-context-store-sequence store))))
         (entry (append (list :id id :terminal nil :outcome nil :events nil
                              :bytes (string-bytes (prin1-to-string data))) data)))
    (push entry (memory-context-store-entries store))
    (memory-context-prune store)
    id))
(defun memory-context-finish (store id outcome)
  (let ((entry (cl-find id (memory-context-store-entries store)
                        :test (function equal) :key (lambda (e) (plist-get e :id)))))
    (when (and entry (not (plist-get entry :terminal)))
      (setf (plist-get entry :terminal) t
            (plist-get entry :outcome) outcome)
      (memory-context-prune store))))
(defun memory-context-get (store id)
  "Return an isolated snapshot or explicit absence without guessing its cause."
  (let ((entry (cl-find id (memory-context-store-entries store)
                        :test (function equal) :key (lambda (e) (plist-get e :id)))))
    (if entry (append (list :available t) (memory-context-copy entry)) '(:available nil))))
(defun memory-context-event (store id event)
  "Append isolated evidence without changing the captured input or outcome."
  (let ((entry (cl-find id (memory-context-store-entries store)
                        :test #'equal :key (lambda (e) (plist-get e :id)))))
    (when entry
      (let ((copy (memory-context-copy event)))
        (setf (plist-get entry :events)
              (append (plist-get entry :events) (list copy))
              (plist-get entry :bytes)
              (+ (plist-get entry :bytes) (string-bytes (prin1-to-string copy))))
        (memory-context-prune store)))))
(provide 'memory-context)
