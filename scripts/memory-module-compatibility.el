;;; memory-module-compatibility.el --- Compare extraction to the committed store -*- lexical-binding: t -*-
;; Export the pre-extraction slopchat-store.el to MEMORY_LEGACY_STORE first.
;; This uses only generated records and an in-process deterministic backend.
(require 'memory)
(load (or (getenv "MEMORY_LEGACY_STORE") (error "Set MEMORY_LEGACY_STORE to the original store source")) nil t)
(defun memory-module-probe-summary (key)
  (concat (format "user: synthetic node %d/%d|" (car key) (cadr key)) (make-string 370 ?x)))
(let* ((directory (make-temp-file "memory-module-compat-" t))
       (old (slopchat-open (expand-file-name "old" directory)))
       (new (memory-open (expand-file-name "new" directory)
                         :backend (list :start (lambda (request _emit done)
                                                 (funcall done (list :text (memory-module-probe-summary (plist-get request :node))))))))
       (main-batches 0) (compact-batches 0) (prior-main 0) (prior-compact 0))
  (unwind-protect
      (progn
        (dotimes (i 1024)
          (let* ((kind (if (= (% i 257) 0) "echo" (nth (% i 4) '("user" "note" "slopchat" "echo"))))
                 (text (if (= (% i 257) 0) (make-string 32000 ?z)
                         (concat (format "record-%d ж🙂|" i) (make-string 370 ?a)))))
            (slopchat-log old kind text)
            (memory-append new (list :kind kind :text text)))
          (let (key)
            (while (setq key (slopchat-dequeue (slopchat-chat-jobs old)))
              (slopchat-build old key (memory-module-probe-summary key))))
          (memory-step new)
          (let* ((main (memory-snapshot new)) (compact (memory-snapshot new :view 'compaction))
                 (main-bytes (plist-get main :bytes)) (compact-bytes (plist-get compact :bytes)))
            (unless (and (eq (plist-get main :state) 'ready)
                         (equal (slopchat-render old) (plist-get main :text))
                         (equal (slopchat-render old (slopchat-chat-comp-view old)) (plist-get compact :text))
                         (equal (slopchat-chat-view old) (plist-get main :view))
                         (equal (slopchat-chat-comp-view old) (plist-get compact :view)))
              (error "Memory extraction changed a view at record %d" i))
            (when (< main-bytes (- prior-main 10000)) (cl-incf main-batches))
            (when (< compact-bytes (- prior-compact 5000)) (cl-incf compact-batches))
            (setq prior-main main-bytes prior-compact compact-bytes)))
        (maphash (lambda (key node)
                   (let* ((span (expt 2 (car key)))
                          (actual (memory-inspect new (list :kind 'node :id (* (cadr key) span) :n span))))
                     (unless (equal actual node) (error "Changed tree node %S" key))))
                 (slopchat-chat-nodes old))
        (unless (and (> main-batches 0) (> compact-batches 0)) (error "Probe did not cross actual view budgets"))
        (let ((main (memory-snapshot new)) (compact (memory-snapshot new :view 'compaction)))
          (memory-close new) (setq new (memory-open (expand-file-name "new" directory)))
          (unless (and (equal main (memory-snapshot new)) (equal compact (memory-snapshot new :view 'compaction)))
            (error "Reopen changed an extracted view")))
        (let ((result (list :passed t :records 1024 :nodes (hash-table-count (slopchat-chat-nodes old))
                            :everyMainViewIdentical t :everyCompactionViewIdentical t :everyNodeIdentical t
                            :mainBatchDrops main-batches :compactionBatchDrops compact-batches :reopenIdentical t
                            :mainBytes prior-main :compactionBytes prior-compact)))
          (with-temp-file "/tmp/memory-module-compatibility.json" (insert (json-serialize result)))
          (princ (json-serialize result))))
    (memory-close new) (slopchat-close old) (delete-directory directory t)))
