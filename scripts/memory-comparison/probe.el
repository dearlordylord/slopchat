;;; probe.el --- Deterministic comparison fixture -*- lexical-binding: t -*-
(require 'unii-memory)
(require 'json)
(let* ((cases (json-parse-string (with-temp-buffer (insert-file-contents (getenv "MEMORY_COMPARISON_CASES")) (buffer-string)) :object-type 'plist :array-type 'list))
       (results (mapcar (lambda (case)
                         (let* ((parts (plist-get case :parts))
                                (best (unii-memory--best-merge parts (plist-get case :total)
                                          (lambda (parent) (member parent (plist-get case :available))))))
                           (if best (- (length parts) (length best)) -1))) cases))
       (directory (make-temp-file "unii-compare-" t)) memory behavior)
  (unwind-protect
      (progn
        (setq memory (unii-memory-open directory :backend (list :start (lambda (_ _emit done) (funcall done '(:error (:kind backend :message "synthetic failure")))))))
        (unii-memory-append memory (list :kind "user" :text (make-string 800 ?x)))
        (unii-memory-step memory)
        (let ((snapshot (unii-memory-snapshot memory)))
          (setq behavior (list :failedContext (list :state (symbol-name (plist-get snapshot :state)) :hasText (if (stringp (plist-get snapshot :text)) t :false)))))
        (unii-memory-close memory)
        (setq memory (unii-memory-open (expand-file-name "oversized" directory)
                       :backend (list :start (lambda (_ _emit done) (funcall done (list :text (make-string 700 ?s)))))))
        (unii-memory-append memory (list :kind "user" :text (make-string 800 ?x)))
        (unii-memory-step memory)
        (setq behavior (append behavior (list :oversized (list :calls (plist-get (unii-memory-inspect memory 'usage) :started)
                                                              :bytes (plist-get (unii-memory--node memory '(0 0)) :size)))))
        (unii-memory-close memory)
        (setq memory (unii-memory-open (expand-file-name "long" directory)))
        (let ((receipt (unii-memory-append memory (list :kind "user" :text (make-string 10000 #x1f642)))))
          (setq behavior (append behavior (list :longRecord (list :records (length (plist-get receipt :ids)) :originalBytes 40000)))))
        (princ (json-serialize (list :mergeResults (vconcat results) :behavior behavior))))
    (when memory (unii-memory-close memory)) (delete-directory directory t)))
