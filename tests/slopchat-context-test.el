        (let ((page (slopchat-ui-context chat (list :id id :section "tools" :limit 8000))))
          (should (equal (plist-get page :format) "lisp"))
          (should (equal (read (plist-get page :text)) tools)))
      (slopchat-close chat) (delete-directory directory t))))

(ert-deftest slopchat-context-status-never-borrows-old-usage ()
  (require 'slopchat-ui)
  (let* ((directory (make-temp-file "context-status-" t))
         (chat (slopchat-open directory))
         (store (slopchat-chat-context chat))
         (old (slopchat-context-capture store "old")))
    (unwind-protect
        (progn
          (slopchat-context-event store old '(:kind usage :source fixture :received-at 123 :metrics (:last (:input 10 :cached-input 0))))
          (should (equal (plist-get (plist-get (slopchat-ui-status chat nil) :contextCall) :id) old))
          (let ((new (slopchat-context-capture store "new")))
            (should (equal (plist-get (plist-get (slopchat-ui-status chat nil) :contextCall) :id) new))
            (should (eq (plist-get (plist-get (slopchat-ui-status chat nil) :contextCall) :observation) :null))))
      (slopchat-close chat) (delete-directory directory t))))

(ert-deftest slopchat-context-thread-rejection-retains-prepared-request ()
  (let* ((store (slopchat-context-store-create))
         (slopchat-model-context-store store)
         (connection (slopchat--connection-create :responses (make-hash-table :test 'equal) :runs (make-hash-table :test 'equal))))
    (cl-letf (((symbol-function 'slopchat-codex-send)
               (lambda (_ message)
                 (puthash (plist-get message :id) '(:error (:message "Fixture auth rejected")) (slopchat-connection-responses connection)))))
      (should-error (slopchat-model-response connection default-directory "instructions" [] nil))
      (let ((entry (car (slopchat-context-store-entries store))))
        (should (eq (plist-get entry :outcome) 'failed))
        (should (= (length (plist-get entry :payload)) 1))
        (should (equal (plist-get (car (plist-get entry :payload)) :method) "thread/start"))))))

(ert-deftest slopchat-context-queued-preparation-provenance ()
  (require 'slopchat)
  (let* ((directory (make-temp-file "queued-context-" t))
         (chat (slopchat-open directory))
         (slopchat-turn-function nil)
         captured)
    (unwind-protect
        (progn
          (slopchat-log chat "user" "prior")
          (slopchat-build chat '(0 0) "prior summary")
          (slopchat-log chat "user" "queued")
          (setf (slopchat-chat-agent chat)
                (lambda (prompt) (funcall agent-model-function (vector (list :role "user" :content prompt))) "answer"))
          (cl-letf (((symbol-function 'slopchat--connection) (lambda (_) 'fixture))
                    ((symbol-function 'slopchat-model-response)
                     (lambda (_connection _directory _instructions messages _model &rest _)
                       (setq captured (funcall slopchat-model-context-observer (list :kind 'prepared :payload messages :provenance slopchat-model-context-provenance))) nil)))
            (slopchat-enqueue (slopchat-chat-queued-input chat) (slopchat--input-create :text "queued" :first 1))
            (slopchat-pump chat)
            (should-not (slopchat-queue-head (slopchat-chat-queued-input chat))))
          (let* ((snapshot (slopchat-context-get (slopchat-chat-context chat) captured))
                 (payload (plist-get snapshot :payload)))
            (should (equal (plist-get (plist-get snapshot :provenance) :memory-prefix) '((0 0))))
            (should (= (plist-get (plist-get snapshot :provenance) :input-first) 1))
            (should (string-match-p "user: prior" (plist-get (aref payload 0) :content)))
            (setf (slopchat-chat-view chat) nil)
            (should (equal payload (plist-get (slopchat-context-get (slopchat-chat-context chat) captured) :payload)))))
      (slopchat-close chat) (delete-directory directory t))))

(ert-deftest slopchat-context-compaction-keeps-historical-provenance ()
  (let* ((directory (make-temp-file "compacted-context-" t))
         (chat (slopchat-open directory)))
    (unwind-protect
        (progn
          (slopchat-log chat "user" "first")
          (slopchat-log chat "user" "second")
          (slopchat-build chat '(1 0) "merged")
          (let* ((view (copy-tree (slopchat-chat-view chat)))
                 (text (slopchat-render chat view))
                 (store (slopchat-chat-context chat))
                 (id (slopchat-context-capture store text (list :memory-prefix view))))
            (setf (slopchat-chat-view chat)
                  (slopchat-merge-to chat (slopchat-chat-view chat) 0 1))
            (should (equal (slopchat-chat-view chat) '((1 0))))
            (should (equal (plist-get (slopchat-context-get store id) :payload) text))
            (should (equal (plist-get (plist-get (slopchat-context-get store id) :provenance) :memory-prefix) view))))
      (slopchat-close chat) (delete-directory directory t))))

(ert-deftest slopchat-context-token-estimate-sections ()
