    (should-not (slopchat-ui--token-estimate '(:payload nil)))))

(ert-deftest slopchat-context-local-send-evidence-and-callback-cleanup ()
  (dolist (failure '(nil t))
    (let* ((store (slopchat-context-store-create))
           (id (slopchat-context-capture store "prepared"))
           (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
           (slopchat-codex-request-observer
            (lambda (_method params)
              (let ((run (gethash (plist-get params :threadId) (slopchat-connection-runs connection))))
                (setf (slopchat-run-context-store run) store (slopchat-run-context-id run) id)))))
      (cl-letf (((symbol-function 'slopchat-codex-send)
                 (lambda (_connection _message) (when failure (error "Write failed")))))
        (let ((run (slopchat-codex-run connection "fixture" "input" nil nil nil 'model)))
          (let ((events (plist-get (slopchat-context-get store id) :events)))
            (if failure
                (progn (should-not events)
                       (should (slopchat-run-done run))
                       (should (= (hash-table-count (slopchat-connection-callbacks connection)) 0)))
              (should (equal (mapcar (lambda (event) (plist-get event :state)) events) '(sent)))
              (should (numberp (plist-get (car events) :sent-at))))))))))

(ert-deftest slopchat-context-call-list-anchor-and-pagination ()
  (require 'slopchat-ui)
  (let* ((directory (make-temp-file "context-pages-" t))
         (chat (slopchat-open directory))
         (store (slopchat-chat-context chat)) oldest)
    (unwind-protect
        (progn
          (dotimes (i 101)
            (let ((id (slopchat-context-capture store (number-to-string i))))
              (unless oldest (setq oldest id))
              (when (< i 100) (slopchat-context-finish store id 'completed))))
          (let ((page (slopchat-ui-context-calls chat (list :id oldest :limit 100))))
            (should (= (plist-get page :total) 101))
            (should (= (plist-get page :offset) 100))
            (should (equal (plist-get (aref (plist-get page :calls) 0) :id) oldest))))
      (slopchat-close chat) (delete-directory directory t))))

(ert-deftest slopchat-context-calibration-baseline ()
  (require 'slopchat-ui)
  (let* ((payload '((:method "thread/start" :params (:model "fixture" :baseInstructions "abcdefgh" :dynamicTools [])) (:method "turn/start" :params (:input [(:type "text" :text "abcdefghijkl")]))))
         (old (list :id "old" :payload payload :events '((:kind usage :source codex :metrics (:last (:input 60))))))
         (new (list :id "new" :payload payload))
         (entries (list new old)))
    (should (= (plist-get (slopchat-ui--calibrated-estimate new entries) :total) 60))
    (should-not (slopchat-ui--calibrated-estimate old entries))
    (should-not (slopchat-ui--calibrated-estimate new (list new)))))


(ert-deftest slopchat-context-next-basis-read-only ()
  (require 'slopchat-ui)
  (slopchat-with-chat
    (setf (slopchat-chat-agent chat) t)
    (unii-memory-observe (slopchat-chat-memory chat)
                    '(:kind prepared :payload ((:method "thread/start" :params (:baseInstructions "fixture" :dynamicTools [])))))
    (let ((before (unii-memory-inspect (slopchat-chat-memory chat) '(:kind attempts :details t)))
          (basis (slopchat-ui--next-basis chat)))
      (should (= (plist-get basis :instructions) 7))
      (should (> (plist-get basis :input) (plist-get basis :memory)))
      (should (equal before (unii-memory-inspect (slopchat-chat-memory chat) '(:kind attempts :details t)))))))
