          (let ((page (slopchat-ui-context-calls chat '(:limit 999))))
            (should (= (length (plist-get page :calls)) 100))
            (should (= (plist-get page :total) 105))
            (should-not (plist-member (aref (plist-get page :calls) 0) :payload)))
          (should (= (length (plist-get (slopchat-ui-context-calls chat '(:offset 100)) :calls)) 5))
          (should-error (slopchat-ui-context-calls chat '(:offset -1)))
          (should (= (slopchat-chat-count chat) 0)))
      (slopchat-close chat) (delete-directory directory t))))

