                  '(:last (:inputTokens 12 :cachedInputTokens 0 :outputTokens -1)
                    :total (:inputTokens 24) :modelContextWindow 100))
                 '(:last (:input 12 :cached-input 0) :total (:input 24) :context-limit 100)))
  (should-not (slopchat-codex--normalize-usage
               '(:last (:inputTokens "12" :outputTokens nil) :modelContextWindow 0)))
