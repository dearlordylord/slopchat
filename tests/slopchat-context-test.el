(ert-deftest slopchat-context-event-isolation ()
  (let* ((store (slopchat-context-store-create))
         (id (slopchat-context-capture store "input"))
         (text (copy-sequence "steering")))
    (slopchat-context-finish store id 'completed)
    (slopchat-context-event store id (list :text text))
    (aset text 0 ?X)
    (let ((entry (slopchat-context-get store id)))
      (should (equal (plist-get (car (plist-get entry :events)) :text) "steering"))
      (should (eq (plist-get entry :outcome) 'completed))
      (should (equal (plist-get entry :payload) "input")))
    (should-not (slopchat-context-event store "missing" '(:text "ignored")))))

(ert-deftest slopchat-context-steering-evidence ()
  (dolist (failure '(nil t))
    (let* ((store (slopchat-context-store-create))
           (id (slopchat-context-capture store "original"))
           (run (slopchat--run-create :thread "thread" :turn "turn"
                                      )))
      (setf (slopchat-run-context-store run) store (slopchat-run-context-id run) id)
      (cl-letf (((symbol-function 'slopchat-codex-rpc)
                 (lambda (_ method params)
                   (should (equal method "turn/steer"))
                   (should (equal (plist-get params :expectedTurnId) "turn"))
                   (if failure (error "Fixture failure") '(:accepted t)))))
        (if failure (should-error (slopchat-codex-steer run "update"))
          (should (equal (slopchat-codex-steer run "update") '(:accepted t))))
      (let* ((entry (slopchat-context-get store id))
             (events (plist-get entry :events)))
        (should (= (length events) 2))
        (should (eq (plist-get (car events) :state) 'prepared))
        (should (eq (plist-get (cadr events) :state)
                    (if failure 'failed 'acknowledged)))
        (should (equal (plist-get entry :payload) "original")))))))

(ert-deftest slopchat-context-submission-acknowledgement ()
  (dolist (rejected '(nil t))
    (let* ((store (slopchat-context-store-create))
           (id (slopchat-context-capture store "input"))
           (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
           callback)
      (cl-letf (((symbol-function 'slopchat-codex-async)
                 (lambda (_ _method _params consumer) (setq callback consumer))))
        (let ((run (slopchat-codex-run connection "fixture" "input" nil nil nil 'model)))
          (setf (slopchat-run-context-store run) store
                (slopchat-run-context-id run) id)
          (funcall callback (if rejected '(:error (:message "denied"))
                              '(:result (:turn (:id "turn")))))
          (let ((event (car (plist-get (slopchat-context-get store id) :events))))
            (should (eq (plist-get event :state) (if rejected 'rejected 'acknowledged)))
            (should (equal (plist-get event :turn-id) (unless rejected "turn"))))
          (should (eq (not (null (slopchat-run-done run))) rejected)))))))

(ert-deftest slopchat-context-late-usage ()
  (let* ((store (slopchat-context-store-create))
         (id (slopchat-context-capture store "input"))
         (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
         (run (slopchat--run-create :connection connection :thread "thread" :turn "turn" )))
    (setf (slopchat-run-context-store run) store (slopchat-run-context-id run) id)
    (puthash "thread" run (slopchat-connection-runs connection))
    (slopchat-codex--finish run)
    (slopchat-context-finish store id 'cancelled)
    (slopchat-codex--dispatch connection '(:method "thread/tokenUsage/updated" :params (:threadId "thread" :turnId "wrong" :tokenUsage (:last (:inputTokens 10)))))
    (should-not (plist-get (slopchat-context-get store id) :events))
    (slopchat-codex--dispatch connection '(:method "thread/tokenUsage/updated" :params (:threadId "thread" :turnId "turn" :tokenUsage (:last (:inputTokens 10)))))
    (let ((entry (slopchat-context-get store id)))
      (should (= (length (plist-get entry :events)) 1))
      (should (eq (plist-get entry :outcome) 'cancelled))
      (should (slopchat-run-done run)))))

(ert-deftest slopchat-context-route-expiry-and-close ()
  (let* ((connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
         (routes (slopchat-connection-observations connection)))
    (puthash "expired" (list :expires 0) routes)
    (dotimes (i 101) (puthash i (list :expires (+ (float-time) 30 i)) routes))
    (slopchat-codex--prune-observations connection)
    (should-not (gethash "expired" routes))
    (should (= (hash-table-count routes) 100))
    (slopchat-codex-close connection)
    (should (= (hash-table-count routes) 0))))

(ert-deftest slopchat-context-usage-deduplication ()
  (let* ((store (slopchat-context-store-create))
         (id (slopchat-context-capture store "input"))
         (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
         (run (slopchat--run-create :connection connection :thread "thread" :turn "turn" ))
         (params '(:threadId "thread" :turnId "turn" :tokenUsage (:last (:inputTokens 10)))))
    (setf (slopchat-run-context-store run) store (slopchat-run-context-id run) id)
    (slopchat-codex--usage connection run params)
    (slopchat-codex--usage connection run params)
    (should (= (length (plist-get (slopchat-context-get store id) :events)) 1))
    (slopchat-codex--usage connection run '(:threadId "thread" :turnId "turn" :tokenUsage (:last (:inputTokens 11))))
    (should (= (length (plist-get (slopchat-context-get store id) :events)) 2))))

(ert-deftest slopchat-context-normalized-usage-availability ()
