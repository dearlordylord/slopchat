(ert-deftest slopchat-context-copy-isolation ()
  (let* ((store (slopchat-context-store-create))
         (text (copy-sequence "original"))
         (table (make-hash-table :test 'equal)))
    (puthash "text" text table)
    (let ((id (slopchat-context-capture store (vector table))))
      (aset text 0 ?X)
      (let ((read (slopchat-context-get store id)))
        (should (equal (gethash "text" (aref (plist-get read :payload) 0)) "original"))
        (aset (gethash "text" (aref (plist-get read :payload) 0)) 0 ?Y))
      (should (equal (gethash "text" (aref (plist-get (slopchat-context-get store id) :payload) 0)) "original")))))
(ert-deftest slopchat-context-retention-and-absence ()
  (let* ((store (slopchat-context-store-create))
         (slopchat-context-terminal-limit 1)
         (slopchat-context-byte-limit 1)
         (id (slopchat-context-capture store "oversized")))
    (should (plist-get (slopchat-context-get store id) :payload))
    (slopchat-context-finish store id 'completed)
    (should (equal (slopchat-context-get store id) '(:available nil)))
    (should (equal (slopchat-context-get (slopchat-context-store-create) id) '(:available nil)))))
(ert-deftest slopchat-context-terminal-order ()
  (let* ((store (slopchat-context-store-create))
         (slopchat-context-terminal-limit 1)
         (first (slopchat-context-capture store "first"))
         (second (slopchat-context-capture store "second")))
    (slopchat-context-finish store second 'completed)
    (should (plist-get (slopchat-context-get store first) :payload))
    (slopchat-context-finish store first 'failed)
    (should (equal (slopchat-context-get store first) '(:available nil)))
    (should (eq (plist-get (slopchat-context-get store second) :outcome) 'completed))))
(ert-deftest slopchat-context-session-identities ()
  (let* ((old (slopchat-context-store-create))
         (fresh (slopchat-context-store-create))
         (id (slopchat-context-capture old "old"))
         (new-id (slopchat-context-capture fresh "new")))
    (should-not (equal id new-id))
    (should-not (plist-get (slopchat-context-get fresh id) :available))
    (should (plist-get (slopchat-context-get fresh new-id) :available))))
(ert-deftest slopchat-context-finish-is-idempotent ()
  (let* ((store (slopchat-context-store-create))
         (id (slopchat-context-capture store "input")))
    (slopchat-context-finish store id 'completed)
    (slopchat-context-finish store id 'failed)
    (should (eq (plist-get (slopchat-context-get store id) :outcome) 'completed))))
(ert-deftest slopchat-context-chat-lifetime ()
  (require 'slopchat)
  (let* ((directory (make-temp-file "context-chat-" t))
         (chat (slopchat-open directory))
         (id (slopchat-context-capture (slopchat-chat-context chat) "private input")))
    (unwind-protect
        (progn
          (slopchat-close chat)
          (should-not (slopchat-chat-context chat))
          (setq chat (slopchat-open directory))
          (should-not (plist-get (slopchat-context-get (slopchat-chat-context chat) id) :available))
          (should (= (slopchat-chat-count chat) 0)))
      (slopchat-close chat)
      (delete-directory directory t))))

(ert-deftest slopchat-context-real-request-boundary ()
  (require 'slopchat-model)
  (let* ((store (slopchat-context-store-create))
         (slopchat-model-context-store store)
         (connection (slopchat--connection-create
                      :responses (make-hash-table :test 'equal)
                      :runs (make-hash-table :test 'equal)))
         sent)
    (cl-letf (((symbol-function 'slopchat-codex-send)
               (lambda (_ message)
                 (push (slopchat-context-copy message) sent)
                 (when (equal (plist-get message :method) "thread/start")
                   (puthash (plist-get message :id) '(:result (:thread (:id "fixture")))
                            (slopchat-connection-responses connection)))))
              ((symbol-function 'slopchat-codex-forget-thread) #'ignore))
      (should (equal (slopchat-model-response
                      connection default-directory "instructions"
                      [(:role "user" :content "hello")] nil nil
                      (lambda ()
                        (should-not slopchat-codex-request-observer)
                        (let ((run (gethash "fixture" (slopchat-connection-runs connection))))
                          (setf (slopchat-run-replies run) '("answer"))
                          (slopchat-codex--finish run))))
                     '(((type . "text") (text . "answer")))))
      (let* ((entry (car (slopchat-context-store-entries store)))
             (payload (plist-get entry :payload)))
        (should (= (length payload) 2))
        (dolist (request payload)
          (let ((wire (cl-find (plist-get request :method) sent
                               :test #'equal :key (lambda (m) (plist-get m :method)))))
            (should (equal (json-serialize (plist-get request :params)) (json-serialize (plist-get wire :params))))))
        (should (eq (plist-get entry :outcome) 'completed))))))

(ert-deftest slopchat-context-submission-failure ()
  (let* ((store (slopchat-context-store-create))
         (slopchat-model-context-store store)
         (connection (slopchat--connection-create
                      :responses (make-hash-table :test 'equal)
                      :runs (make-hash-table :test 'equal))))
    (cl-letf (((symbol-function 'slopchat-codex-send)
               (lambda (_ message)
                 (if (equal (plist-get message :method) "thread/start")
                     (puthash (plist-get message :id)
                              '(:result (:thread (:id "failure-fixture")))
                              (slopchat-connection-responses connection))
                   (error "Fixture submission failed"))))
              ((symbol-function 'slopchat-codex-forget-thread) #'ignore))
      (should-error (slopchat-model-response
                     connection default-directory "instructions" [] nil))
      (let ((entry (car (slopchat-context-store-entries store))))
        (should entry)
        (should (plist-get entry :terminal))
        (should (eq (plist-get entry :outcome) 'failed))))))

(ert-deftest slopchat-context-cancelled-adapter ()
  (let* ((store (slopchat-context-store-create))
         (slopchat-model-context-store store)
         (slopchat--round-token (list t))
         (connection (slopchat--connection-create
                      :responses (make-hash-table :test 'equal)
                      :runs (make-hash-table :test 'equal))))
    (cl-letf (((symbol-function 'slopchat-codex-send)
               (lambda (_ message)
                 (when (equal (plist-get message :method) "thread/start")
                   (puthash (plist-get message :id)
                            '(:result (:thread (:id "cancel-fixture")))
                            (slopchat-connection-responses connection)))))
              ((symbol-function 'slopchat-codex-forget-thread) #'ignore))
      (catch 'fixture-cancel
        (slopchat-model-response connection default-directory "instructions" [] nil
                                 nil (lambda () (throw 'fixture-cancel t))))
      (let ((entry (car (slopchat-context-store-entries store))))
        (should (plist-get entry :terminal))
        (should (eq (plist-get entry :outcome) 'cancelled))))))

(ert-deftest slopchat-context-tool-boundary-adapter ()
  (let* ((store (slopchat-context-store-create))
