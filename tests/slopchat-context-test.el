                  '(:last (:inputTokens 10 :outputTokens 2 :reasoningOutputTokens 3)
                    :modelContextWindow 100))
                 '(:context-limit 100)))
  (should (equal (plist-get (slopchat-codex--normalize-usage
                            '(:last (:outputTokens 3 :reasoningOutputTokens 3))) :last)
                 '(:output 3 :reasoning-output 3))))

(ert-deftest slopchat-context-ui-pagination ()
  (require 'slopchat-ui)
  (let* ((directory (make-temp-file "context-ui-" t))
         (chat (slopchat-open directory))
         (payload (make-string 9000 ?a))
         (id (slopchat-context-capture (slopchat-chat-context chat) payload)))
    (unwind-protect
        (let* ((first (slopchat-ui-context chat (list :id id :limit 99999)))
               (second (slopchat-ui-context chat (list :id id :offset (plist-get first :end) :limit 8000))))
          (should (= (length (plist-get first :text)) 8000))
          (should (equal (concat (plist-get first :text) (plist-get second :text))
                         (prin1-to-string payload)))
          (should (eq (plist-get (slopchat-ui-context chat (list :id "missing")) :available) :false))
          (should-error (slopchat-ui-context chat '(:offset -1)))
          (should-error (slopchat-ui-context chat '(:id 12)))
          (should (= (slopchat-chat-count chat) 0)))
      (slopchat-close chat) (delete-directory directory t))))

(ert-deftest slopchat-context-call-list-bounds ()
