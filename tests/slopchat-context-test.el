    (should-not (slopchat-codex--normalize-usage value)))
  (dolist (value '(12 "invalid" [1 2] (:inputTokens . 1)))
    (should-not (slopchat-codex--normalize-usage (list :last value)))))

(ert-deftest slopchat-context-early-response ()
  (let* ((store (slopchat-context-store-create))
         (slopchat-model-context-store store)
         (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)
                      :responses (make-hash-table :test 'equal))))
    (cl-letf (((symbol-function 'slopchat-codex-send)
               (lambda (_ message)
                 (pcase (plist-get message :method)
                   ("thread/start"
                    (puthash (plist-get message :id) '(:result (:thread (:id "early")))
                             (slopchat-connection-responses connection)))
                   ("turn/start"
                    (slopchat-codex--dispatch connection
                     (list :id (plist-get message :id) :result '(:turn (:id "turn"))))
                    (slopchat-codex--dispatch connection
                     '(:method "thread/tokenUsage/updated" :params
                       (:threadId "early" :turnId "turn" :tokenUsage (:last (:inputTokens 3)))))
                    (slopchat-codex--finish
                     (gethash "early" (slopchat-connection-runs connection)))))))
              ((symbol-function 'slopchat-codex-forget-thread) #'ignore))
      (slopchat-model-response connection default-directory "instructions" [] nil)
      (let ((events (plist-get (car (slopchat-context-store-entries store)) :events)))
        (should (= (length events) 4))
        (should (equal (mapcar (lambda (event) (plist-get event :state)) events)
                       '(prepared acknowledged nil sent)))
        (should (eq (plist-get (nth 2 events) :kind) 'usage))))))

(ert-deftest slopchat-context-inconsistent-reasoning-counts ()
