(ert-deftest slopchat-reopen-preserves-decision-correction-and-zoom ()
  ;; Storage fidelity is separate from model summary quality.
  (slopchat-with-chat
    (let ((original "Decision: use /tmp/retention-fixture.json. Do not restart. TODO: verify pagination.")
          (correction "Correction: use /tmp/retention-final.json instead; pagination remains open.")
          (slopchat-page-bytes 4096))
      (slopchat-log chat "user" original)
      (slopchat-log chat "user" correction)
      (let* ((rendered (slopchat-render chat))
             (serialized (slopchat-model-input (vector (list :role "user" :content rendered)))))
        (slopchat-close chat)
        (setq chat (slopchat-open directory))
        (should (equal rendered (slopchat-render chat)))
        (should (equal serialized (slopchat-model-input (vector (list :role "user" :content (slopchat-render chat))))))
        (should (equal original (plist-get (slopchat-zoom chat 0 1) :text)))
        (should (equal correction (plist-get (slopchat-zoom chat 1 1) :text)))))))

(ert-deftest slopchat-compaction-source-fidelity-instruction ()
  (dolist (key '((0 0) (1 0)))
    (let* ((source "user: Topic B remains unresolved.")
           (context "<chat>\n0+1|user: Topic A uses SECRET_A.\n</chat>")
           (job (list :node key :source source :context context))
           (task (slopchat-memory-task job)))
