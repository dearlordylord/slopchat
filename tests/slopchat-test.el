;;; slopchat-test.el --- Durable memory and protocol tests -*- lexical-binding: t -*-
(require 'ert)
(add-to-list 'load-path (file-name-directory (or load-file-name buffer-file-name)))
(require 'slopchat-memory-compat)
(add-to-list 'load-path (expand-file-name "../lisp" (file-name-directory load-file-name)))
(require 'slopchat)

(defmacro slopchat-with-chat (&rest body)
  `(let* ((directory (make-temp-file "slopchat-test-" t))
          (chat (slopchat-open directory)))
     (unwind-protect (progn ,@body)
       (slopchat-close chat) (delete-directory directory t))))
(defun slopchat-test-text (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(ert-deftest slopchat-utf8-lossless-splitting ()
  (dolist (limit '(4 5 7 20 512))
    (dolist (text '("" "hello" "hello" "🙂a🦀é\n𐀀終"))
      (let ((parts (slopchat-split text limit)))
        (should (equal (apply #'concat parts) text))
        (dolist (part parts) (should (<= (slopchat-bytes part) limit))))))
  (should (= (slopchat-bytes "🙂é") 6)))
(ert-deftest slopchat-tool-output-head-tail ()
  (let ((text (concat (make-string 16000 ?a) (make-string 16000 ?b))))
    (should (equal (slopchat-clip text) (concat (make-string 15000 ?a) (make-string 15000 ?b))))))
(ert-deftest slopchat-no-model-for-short-source ()
  (slopchat-with-chat
   (slopchat-log chat "user" "one") (slopchat-log chat "user" "two")
   (should (slopchat-node chat '(1 0)))
   (should-not (slopchat-queue-head (slopchat-chat-jobs chat)))
   (should (= (slopchat-chat-cursor chat) 2))))
(ert-deftest slopchat-node-once-and-reopen-identical ()
  (slopchat-with-chat
   (slopchat-log chat "user" "first") (slopchat-log chat "slopchat" "second")
   (let* ((view (slopchat-render chat))
          (checkpoint (slopchat-test-text (expand-file-name "view.json" directory)))
          (tree (car (directory-files (expand-file-name "tree" directory) t "jsonl$")))
          (before (slopchat-test-text tree)))
     (slopchat-build chat '(0 0) "replacement")
     (should (equal (slopchat-test-text tree) before))
     (slopchat-close chat) (setq chat (slopchat-open directory))
     (should (equal (slopchat-render chat) view))
     (should (equal (slopchat-test-text (expand-file-name "view.json" directory)) checkpoint))
     (should (equal (plist-get (slopchat-zoom chat 0 1) :text) "first")))))
(ert-deftest slopchat-lock-exclusion-and-release ()
