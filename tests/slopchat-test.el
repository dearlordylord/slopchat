(ert-deftest slopchat-summary-retries-use-same-provider-conversation ()
  (slopchat-with-chat
    (let ((slopchat-summary-function nil) threads prompts runs (sequence 0))
      (slopchat-log chat "user" (make-string 600 ?a))
      (cl-letf (((symbol-function 'slopchat--connection) (lambda (_) 'fake))
                ((symbol-function 'slopchat-codex-thread)
                 (lambda (&rest _) (push "summary" threads) "summary"))
                ((symbol-function 'slopchat-codex-forget-thread) #'ignore)
                ((symbol-function 'slopchat-codex-run)
                 (lambda (_ thread prompt _handler _event callback &optional _kind)
                   (push (cons thread prompt) prompts)
                   (let ((run (slopchat--run-create :thread thread :replies
                               (list (if (= (cl-incf sequence) 1) (make-string 520 ?x) "short")))))
                     (push run runs) (funcall callback run) run))))
        (slopchat-schedule chat))
      (should (= (length threads) 1))
      (should (= (length runs) 2))
      (should (equal (mapcar #'car prompts) '("summary" "summary")))
      (should (string-match-p "Too long:" (cdar prompts)))
      (should (string-match-p "<input>" (cdr (cadr prompts))))
      (should (= (slopchat-memory-usage-started (slopchat-memory-usage-ledger chat)) 2)))))

(ert-deftest slopchat-summary-captures-attempts-and-provider-totals ()
  (slopchat-with-chat
    (let* ((connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
           (slopchat-summary-function nil) callbacks (turn 0))
      (slopchat-log chat "user" (make-string 600 ?a))
      (cl-letf (((symbol-function 'slopchat--connection) (lambda (_) connection))
                ((symbol-function 'slopchat-codex-rpc)
                 (lambda (_ method params)
                   (when slopchat-codex-request-observer
                     (funcall slopchat-codex-request-observer method params))
                   '(:thread (:id "summary"))))
                ((symbol-function 'slopchat-codex-async)
                 (lambda (_ method params callback)
                   (when slopchat-codex-request-observer
                     (funcall slopchat-codex-request-observer method params))
                   (when (equal method "turn/start")
                     (push callback callbacks))))
                ((symbol-function 'slopchat-codex-forget-thread) #'ignore))
        (slopchat-schedule chat)
        (dotimes (i 2)
          (let* ((run (gethash "summary" (slopchat-connection-runs connection)))
                 (id (format "turn-%d" (cl-incf turn))))
            (funcall (pop callbacks) (list :result (list :turn (list :id id))))
            (slopchat-codex--usage connection run
              (list :threadId "summary" :turnId id :tokenUsage
                    (list :last '(:inputTokens 10 :cachedInputTokens 8)
                          :total (list :inputTokens (* turn 10) :cachedInputTokens (* turn 8)))))
            (setf (slopchat-run-replies run) (list (if (= i 0) (make-string 520 ?x) "short")))
            (slopchat-codex--finish run))))
      (let* ((entries (slopchat-context-store-entries (slopchat-chat-context chat)))
             (latest (car entries)) (provenance (plist-get latest :provenance)))
        (should (= (length entries) 2))
        (should (eq (plist-get provenance :kind) 'compaction))
        (should (= (plist-get provenance :attempt) 2))
        (should (= (length (plist-get provenance :prior-turns)) 1))
        (should (plist-get latest :terminal))
        (should (equal (plist-get latest :outcome) 'completed))
        (should (equal (plist-get (car (plist-get latest :payload)) :method) "thread/start"))
        (should (= (slopchat-memory-usage-input (slopchat-memory-usage-ledger chat)) 20))
        (should (= (slopchat-memory-usage-cached-input (slopchat-memory-usage-ledger chat)) 16))))))

(ert-deftest slopchat-delayed-main-merge-rearms-compaction-batch ()
  (slopchat-with-chat
    (let ((slopchat-view-high 150) (slopchat-view-low 90)
          (slopchat-compaction-high 150) (slopchat-compaction-low 90))
      (setf (slopchat-chat-batching chat) t
            (slopchat-chat-view chat) '((0 0) (0 1))
            (slopchat-chat-comp-view chat) '((0 0) (0 1)))
      (cl-letf (((symbol-function 'memory--view-size) (lambda (&rest _) 110))
                ((symbol-function 'memory--merge-to)
                 (lambda (_ view _low &rest _) (if (equal view '((0 0) (0 1))) '((1 0)) view))))
        (slopchat--shrink chat)
        (should (slopchat-chat-comp-batching chat))
        (should (equal (slopchat-chat-comp-view chat) '((1 0)))))
      (setf (slopchat-chat-view chat) nil (slopchat-chat-comp-view chat) nil))))

(ert-deftest slopchat-summary-work-includes-entire-tree-once ()
  (slopchat-with-chat
    (let* ((calls 0)
           (slopchat-summary-function
           (lambda (_chat _key _prompt _context done)
             (cl-incf calls)
             (funcall done (make-string 300 ?s) nil))))
      (dotimes (_ 16) (slopchat-log chat "user" (make-string 600 ?a)))
      (slopchat-schedule chat)
      ;; Sixteen model-built leaves and fifteen model-built internal nodes.
