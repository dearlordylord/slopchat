;;; Accounting regression tests -*- lexical-binding: t -*-
(require 'ert)
(require 'slopchat-memory-usage)
(ert-deftest slopchat-memory-usage-replacement ()
  (let ((ledger (slopchat-memory-usage-create)))
    (slopchat-memory-usage-start ledger 'a)
    (slopchat-memory-usage-start ledger 'a)
    (slopchat-memory-usage-start ledger 'b)
    (slopchat-memory-usage-observe ledger 'a '(:input 10 :output 0))
    (slopchat-memory-usage-observe ledger 'a '(:input 10 :output 0))
    (should (equal (slopchat-memory-usage-project ledger)
                   '(:started 2 :input 10 :output 0 :inputObserved 1 :outputObserved 1 :cachedInput 0 :cachedInputObserved 0 :cacheWriteInput 0 :cacheWriteInputObserved 0)))
    (slopchat-memory-usage-observe ledger 'a '(:input 12))
    (slopchat-memory-usage-retire ledger 'a)
    (slopchat-memory-usage-observe ledger 'a '(:input 100))
    (should (= (slopchat-memory-usage-input ledger) 12))))
(require 'slopchat-codex)
(ert-deftest slopchat-memory-usage-late-route ()
  (let* ((ledger (slopchat-memory-usage-create))
         (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
         (run (slopchat--run-create :connection connection :thread "memory" :turn "one")))
    (slopchat-memory-usage-start ledger 'attempt)
    (puthash run (list :memory-ledger ledger :memory-attempt 'attempt) slopchat-codex--context-metadata)
    (puthash "memory" run (slopchat-connection-runs connection))
    (slopchat-codex--finish run)
    (slopchat-codex--usage connection nil '(:threadId "memory" :turnId "wrong" :tokenUsage (:last (:inputTokens 99))))
    (should (= (slopchat-memory-usage-input ledger) 0))
    (slopchat-codex--usage connection nil '(:threadId "memory" :turnId "one" :tokenUsage (:last (:inputTokens 12 :outputTokens 0))))
    (should (= (slopchat-memory-usage-input ledger) 12))
    (slopchat-codex-close connection)
    (should (= (hash-table-count (slopchat-memory-usage-attempts ledger)) 0))
    (should (= (slopchat-memory-usage-input ledger) 12))))
(ert-deftest slopchat-memory-usage-active-and-expired ()
  (let* ((ledger (slopchat-memory-usage-create))
         (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
         (run (slopchat--run-create :connection connection :thread "m" :turn "t")))
    (slopchat-memory-usage-start ledger 'a)
    (puthash run (list :memory-ledger ledger :memory-attempt 'a) slopchat-codex--context-metadata)
    (slopchat-codex--usage connection run '(:threadId "m" :turnId "t" :tokenUsage (:last (:inputTokens 0 :outputTokens 2))))
    (should (= (slopchat-memory-usage-input-observed ledger) 1))
    (slopchat-codex--finish run)
    (setf (plist-get (gethash '("m" "t") (slopchat-connection-observations connection)) :expires) 0)
    (slopchat-codex--prune-observations connection)
    (should (= (hash-table-count (slopchat-memory-usage-attempts ledger)) 0))
    (should (= (slopchat-memory-usage-output ledger) 2))))

(ert-deftest slopchat-memory-usage-retry-late-reports ()
  (let* ((ledger (slopchat-memory-usage-create))
         (connection (slopchat--connection-create :runs (make-hash-table :test 'equal))))
    (dolist (turn '("one" "two"))
      (let ((run (slopchat--run-create :connection connection :thread "retry" :turn turn)))
        (slopchat-memory-usage-start ledger turn)
        (puthash run (list :memory-ledger ledger :memory-attempt turn) slopchat-codex--context-metadata)
        (puthash "retry" run (slopchat-connection-runs connection))
        (slopchat-codex--finish run)))
    (dolist (turn '("two" "one" "one"))
      (slopchat-codex--usage connection nil
        (list :threadId "retry" :turnId turn :tokenUsage
              '(:last (:inputTokens 10 :outputTokens 2 :cachedInputTokens 8)))))
    (slopchat-codex--usage connection nil
      '(:threadId "retry" :turnId "one" :tokenUsage (:last (:inputTokens 12 :cachedInputTokens 9 :cacheWriteInputTokens 0))))
    (should (= (slopchat-memory-usage-input ledger) 22))
    (should (= (slopchat-memory-usage-output ledger) 4))
    (should (= (slopchat-memory-usage-cached-input ledger) 17))
    (should (= (slopchat-memory-usage-cached-input-observed ledger) 2))
    (should (= (slopchat-memory-usage-cache-write-input-observed ledger) 1))
    (slopchat-codex-close connection)
    (should (= (slopchat-memory-usage-cached-input ledger) 17))))

(ert-deftest slopchat-memory-usage-absolute-thread-totals ()
  (let* ((ledger (slopchat-memory-usage-create))
         (state (list :totals nil)))
    (slopchat-memory-usage-start ledger 'one)
    (slopchat-memory-usage-start ledger 'two)
    (slopchat-memory-usage-observe-total ledger 'one state '(:input 10 :output 2 :cached-input 8))
    ;; Two provider increments in one attempt must both count.
    (slopchat-memory-usage-observe-total ledger 'one state '(:input 20 :output 4 :cached-input 16))
    (slopchat-memory-usage-observe-total ledger 'two state '(:input 30 :output 6 :cached-input 24))
    ;; Repeated and late older totals must not charge again.
    (slopchat-memory-usage-observe-total ledger 'two state '(:input 30 :output 6 :cached-input 24))
    (slopchat-memory-usage-observe-total ledger 'one state '(:input 20 :output 4 :cached-input 16))
    (should (= (slopchat-memory-usage-input ledger) 30))
    (should (= (slopchat-memory-usage-output ledger) 6))
    (should (= (slopchat-memory-usage-cached-input ledger) 24))
    (should (= (slopchat-memory-usage-input-observed ledger) 2))
    (should (= (slopchat-memory-usage-cached-input-observed ledger) 2))))

(ert-deftest slopchat-memory-usage-preserves-legacy-epoch ()
  (let ((ledger (slopchat-memory-usage-create))
        (legacy '(:started 2 :input 100 :output 10 :inputObserved 2 :outputObserved 2)))
    (puthash ledger (list :since 123 :legacy legacy) slopchat-memory-usage--epochs)
    (slopchat-memory-usage-start ledger 'new)
    (slopchat-memory-usage-observe-total ledger 'new (list :totals nil) '(:input 12 :output 2))
    (let ((value (slopchat-memory-usage-project ledger)))
      (should (= (plist-get value :input) 12))
      (should (= (plist-get value :since) 123))
      (should (equal (plist-get value :legacy) legacy)))))
