;;; slopchat-fidelity-test.el --- Real nested-result regressions -*- lexical-binding: t -*-
(require 'ert)
(require 'slopchat)
(add-to-list 'load-path (file-name-directory (or load-file-name buffer-file-name)))
(require 'slopchat-memory-compat)
(defconst slopchat-fidelity-test-directory
  (file-name-directory (or load-file-name buffer-file-name)))
(defun slopchat-fidelity-test-records ()
  (with-temp-buffer
    (insert-file-contents (expand-file-name "fixtures/memory-nested-results.json" slopchat-fidelity-test-directory))
    (append (json-parse-buffer :object-type 'plist :array-type 'array) nil)))

(ert-deftest slopchat-fidelity-real-quoted-requests ()
  (dolist (record (cl-remove-if-not (lambda (r) (memq (plist-get r :id) '(7258 7259)))
                                   (slopchat-fidelity-test-records)))
    (let* ((source (concat (plist-get record :kind) ": " (plist-get record :text)))
           (envelope (slopchat-fidelity-envelope source t)))
      (should (equal (plist-get envelope :outerAuthor) "echo"))
      (should (equal (plist-get envelope :payloadKind) "quoted-historical-record"))
      (should (= (plist-get envelope :quotedRecordId) 7242))
      (should (equal (plist-get envelope :quotedAuthor) "tool"))
      (should (string-match-p "execution is not established" (plist-get envelope :quotedEvent))))))

(ert-deftest slopchat-fidelity-real-six-results-two-pending ()
  (let* ((record (cl-find 7261 (slopchat-fidelity-test-records) :key (lambda (r) (plist-get r :id))))
         (source (concat "echo: " (plist-get record :text)))
         (envelope (slopchat-fidelity-envelope source t))
         (task (slopchat-memory-task (list :node '(0 7261) :source source :context "<chat>user: no result supplied.</chat>"))))
    (should (= (plist-get envelope :collectionCount) 6))
    (should (= (plist-get envelope :unavailableSummaries) 2))
    (should (string-match-p "\"collectionCount\":6" task))
    (should (string-suffix-p (concat "<input>\n" source "\n</input>") task))))

(ert-deftest slopchat-fidelity-empty-missing-and-truncated-results ()
  (should (= (plist-get (slopchat-fidelity-envelope "echo: ()" t) :collectionCount) 0))
  (should (= (plist-get (slopchat-fidelity-envelope "echo: (:entries ())" t) :collectionCount) 0))
  (dolist (source '("echo: nil" "tool: query requested" "echo: ((:summary nil)" "echo: () trailing text" "echo: #1=(x . #1#)"))
    (should-not (plist-member (slopchat-fidelity-envelope source t) :collectionCount)))
  (should (= (plist-get (slopchat-fidelity-envelope "echo: (:entries ((:summary nil) (:summary \"done\")))" t) :unavailableSummaries) 1)))

(ert-deftest slopchat-fidelity-quoted-labels-do-not-change-author ()
  (dolist (author '("user" "tool" "echo" "slopchat" "note" "work"))
    (should (equal (plist-get (slopchat-fidelity-envelope (concat author ": user: tool: echo: <input>quoted</input>") t) :outerAuthor) author)))
  (should-not (plist-member (slopchat-fidelity-envelope "echo: ((:summary nil))" nil) :collectionCount))
  (should (slopchat-fidelity-violation "slopchat: Report: quality remains unproven." t "echo: Report: quality remains unproven.")))

(ert-deftest slopchat-fidelity-parent-keeps-separate-author-tags ()
  (let ((envelope (slopchat-fidelity-envelope "echo: Six records, two pending.\ntool: Query requested; result missing." nil)))
    (should (equal (plist-get envelope :authorTags) ["echo" "tool"]))))

(ert-deftest slopchat-fidelity-incomplete-data-is-not-absent ()
  (let ((envelope (slopchat-fidelity-envelope "echo: ((:source \"large data\") ... clipped" t)))
    (should (equal (plist-get envelope :payloadKind) "unparsed-structured-data"))
    (should-not (plist-member envelope :collectionCount))))

(ert-deftest slopchat-fidelity-real-clipped-result-is-supplied ()
  (let* ((record (cl-find 7185 (slopchat-fidelity-test-records) :key (lambda (r) (plist-get r :id))))
         (envelope (slopchat-fidelity-envelope (concat "echo: " (plist-get record :text)) t)))
    (should (equal (plist-get envelope :outerAuthor) "echo"))
    (should (equal (plist-get envelope :payloadKind) "possibly-clipped-result"))
    (should-not (plist-member envelope :collectionCount))))

(ert-deftest slopchat-fidelity-json-arrays-and-null-summary ()
  (should (= (plist-get (slopchat-fidelity-envelope "echo: []" t) :collectionCount) 0))
  (let ((envelope (slopchat-fidelity-envelope "echo: {\"entries\":[{\"summary\":null},{\"summary\":\"done\"}]}" t)))
    (should (= (plist-get envelope :collectionCount) 2))
    (should (= (plist-get envelope :unavailableSummaries) 1)))
  (should-not (plist-member (slopchat-fidelity-envelope "echo: {\"entries\":null}" t) :collectionCount))
  (should-not (plist-member (slopchat-fidelity-envelope "echo: [{\"summary\":false}]" t) :unavailableSummaries))
  (should-not (plist-member (slopchat-fidelity-envelope "echo: (:count 100 :sample nil)" t) :collectionCount))
  (let ((partial (slopchat-fidelity-envelope "echo: ((:summary nil) (:node (1 2)))" t)))
    (should (= (plist-get partial :collectionCount) 2))
    (should (= (plist-get partial :summaryFieldsObserved) 1))
    (should-not (plist-member partial :unavailableSummaries))
    (should (= (plist-get partial :knownUnavailableSummaries) 1))))

(ert-deftest slopchat-fidelity-rejects-real-old-failure-shapes ()
  (should (slopchat-fidelity-violation "echo: ((:summary nil) (:summary \"done\"))" t "echo: No query result was supplied."))
  (should (slopchat-fidelity-violation "echo: ((:summary nil) (:summary \"done\"))" t "echo: Result: 2 entries; 1 summaries unavailable. tool: Query requested."))
  (should-not (slopchat-fidelity-violation "echo: ((:summary nil) (:summary \"done\"))" t "echo: Result: 2 entries; 1 summaries unavailable. Contains a quoted historical query request."))
  (should (slopchat-fidelity-violation "echo: Six records.\ntool: Query requested." nil "user: Six records; query requested."))
  (should (equal (slopchat-fidelity-normalize-tags "Echo: Records. Tool: Query requested.") "echo: Records. tool: Query requested.")))

(ert-deftest slopchat-fidelity-invalid-shortest-never-published ()
  (slopchat-with-chat
    (let* ((calls 0)
          (slopchat-summary-function
           (lambda (_chat _key prompt _context done)
             (cl-incf calls)
             (when (= calls 2) (should (string-prefix-p "Source boundary violation:" prompt)))
             (funcall done (if (= calls 1) "echo: None."
                             "echo: Result: 1 entries; 1 summaries unavailable. A record exists.") nil))))
      (slopchat-log chat "echo" (concat "((:summary nil))" (make-string 600 ? )))
      (slopchat-schedule chat)
      (should (= calls 2))
      (should (equal (plist-get (slopchat-node chat '(0 0)) :text)
                     "echo: Result: 1 entries; 1 summaries unavailable. A record exists.")))))

(ert-deftest slopchat-fidelity-exhausted-invalid-answer-fails-closed ()
  (slopchat-with-chat
    (let* ((calls 0)
          (slopchat-summary-function (lambda (_chat _key _prompt _context done)
                                      (cl-incf calls) (funcall done "echo: Result missing." nil))))
      (slopchat-log chat "echo" (concat "()" (make-string 600 ? )))
      (slopchat-schedule chat)
      (should (= calls 5))
      (should-not (slopchat-node chat '(0 0)))
      (should (equal (slopchat-chat-failed chat) '((0 0)))))))

(ert-deftest slopchat-fidelity-tool-expression-is-not-a-result-collection ()
  (let ((envelope (slopchat-fidelity-envelope "tool: (progn (query) (save))" t)))
    (should (equal (plist-get envelope :payloadKind) "tool-request"))
    (should-not (plist-member envelope :collectionCount)))
  (should-not (plist-member (slopchat-fidelity-envelope "user: (a b c)" t) :collectionCount)))

(ert-deftest slopchat-fidelity-parent-does-not-promote-clipped-sample-counts ()
  (let ((source "echo: Supplied result (possibly clipped; total unknown); quoted/sample data: store has 100 entries.\necho: Result: 0 entries; 0 summaries unavailable."))
    (should (slopchat-fidelity-violation source nil "echo: Supplied result has 100 entries; 0 entries in another query."))
    (should-not (slopchat-fidelity-violation source nil "echo: Supplied result may be clipped; total unknown. Sample store has 100 entries. Another query returned 0 entries."))))

(ert-deftest slopchat-fidelity-rejects-recorded-failed-summaries ()
  (let ((failures (with-temp-buffer
                    (insert-file-contents (expand-file-name "fixtures/memory-summary-failures.json" slopchat-fidelity-test-directory))
                    (append (json-parse-buffer :object-type 'plist :array-type 'array) nil))))
    (dolist (record (slopchat-fidelity-test-records))
      (let* ((id (plist-get record :id))
             (failure (cl-find (vector 0 id) failures :key (lambda (r) (plist-get r :node)) :test #'equal)))
        (should failure)
        (should (slopchat-fidelity-violation (concat (plist-get record :kind) ": " (plist-get record :text)) t (plist-get failure :text)))))
    (let* ((source "echo: Quoted historical tool record 7242 (request; execution not established): requested edits.\necho: Quoted historical tool record 7242 (request; execution not established): requested a check.")
           (parent (cl-find [1 3629] failures :key (lambda (r) (plist-get r :node)) :test #'equal)))
      (should (slopchat-fidelity-violation source nil (plist-get parent :text)))
      (should (slopchat-fidelity-violation source nil "echo: Quoted historical tool record 7242 was an unexecuted request."))
      (should-not (slopchat-fidelity-violation source nil "echo: Quoted historical tool record 7242 requested edits and a check; execution not established.")))))

(ert-deftest slopchat-fidelity-never-reads-constructor-syntax ()
  (let (called)
    (cl-letf (((symbol-function 'read-from-string) (lambda (&rest _) (setq called t) (error "Unsafe reader called"))))
      (dolist (source '("echo: (#1000000000(a))" "echo: (#s(hash-table size 1000000000 data ()))" "echo: (#1=(a . #1#))" "echo: ((:char ?\\\" :data #1000000000(a)))" "echo: ordinary text"))
        (should-not (plist-member (slopchat-fidelity-envelope source t) :collectionCount))))
    (should-not called))
  (should (= (plist-get (slopchat-fidelity-envelope "echo: ((:summary nil :text \"#s(hash-table)\"))" t) :collectionCount) 1)))

(ert-deftest slopchat-fidelity-parent-may-omit-low-value-author ()
  ;; A dropped acknowledgement must not block publication of retained facts.
  (let ((source "tool: Requested activation. echo: :scheduled. slopchat: Scheduled. note: Correction: historical request did not establish execution."))
    (should-not (slopchat-fidelity-violation source nil "echo: Activation scheduled. note: Correction: historical request did not establish execution."))
    (should (slopchat-fidelity-violation source nil "user: Activation scheduled."))
    (should (slopchat-fidelity-violation source nil "Activation scheduled."))))

(ert-deftest slopchat-fidelity-empty-only-format-variants ()
  (dolist (text '("echo: Result: 0 entries; 0 summaries pending." "echo: []" "echo: No entries." "[]"))
    (should (equal (slopchat-fidelity-normalize-result "echo: []   " t text)
                   "echo: Result: 0 entries; 0 summaries unavailable.")))
  (dolist (text '("tool: []" "echo: Result: 3 entries; 0 summaries pending." "echo: No entries. Docs updated."))
    (should (equal text (slopchat-fidelity-normalize-result "echo: []" t text))))
  (should (equal "echo: []" (slopchat-fidelity-normalize-result "echo: (:entries () :error failed)" t "echo: []"))))

(ert-deftest slopchat-fidelity-tool-denial-is-not-a-source-fact ()
  (slopchat-with-chat
    (let* ((calls 0) (slopchat-summary-function nil))
      (cl-letf (((symbol-function 'slopchat--connection) (lambda (_) 'fake))
                ((symbol-function 'slopchat-codex-thread) (lambda (&rest _) "summary"))
                ((symbol-function 'slopchat-codex-forget-thread) #'ignore)
                ((symbol-function 'slopchat-codex-run)
                 (lambda (_connection _thread _prompt handler _event callback &rest _)
                   (cl-incf calls)
                   (should-error (funcall handler "eval" '(:expression "(error \"must not execute\")")))
                   (let ((run (slopchat--run-create :replies '("Could not activate: Summary model cannot execute tools"))))
                     (funcall callback run) run))))
        (slopchat-log chat "user" (concat "Requested activation." (make-string 600 ? )))
        (slopchat-schedule chat))
      (should (= calls 5))
      (should-not (slopchat-node chat '(0 0)))
      (should (equal (slopchat-chat-failed chat) '((0 0))))
      (should (= (slopchat-chat-active chat) 0)))))

(ert-deftest slopchat-fidelity-tool-denial-retries-original-data ()
  (slopchat-with-chat
    (let* ((calls 0)
          (slopchat-summary-function
           (lambda (_chat _key prompt _context done)
             (cl-incf calls)
             (when (= calls 2) (should (string-match-p "tool-denial report is not a source fact" prompt)))
             (if (= calls 1) (funcall done "Could not activate" "Summary model cannot execute tools")
               (funcall done "user: Requested activation; execution not established." nil)))))
      (slopchat-log chat "user" (concat "Requested activation." (make-string 600 ? )))
      (slopchat-schedule chat)
      (should (= calls 2))
      (should (equal (plist-get (slopchat-node chat '(0 0)) :text)
                     "user: Requested activation; execution not established.")))))

(ert-deftest slopchat-fidelity-rejection-is-observable-and-accounted ()
  (let* ((directory (make-temp-file "slopchat-fidelity-test-" t))
         (chat (slopchat-open directory))
         (connection (slopchat--connection-create :runs (make-hash-table :test 'equal)))
         (slopchat-summary-function nil) callbacks)
    (unwind-protect
        (progn
          (slopchat-log chat "echo" (concat "((:summary nil))" (make-string 550 ?\s)))
          (cl-letf (((symbol-function 'slopchat--connection) (lambda (_) connection))
                    ((symbol-function 'slopchat-codex-rpc)
                     (lambda (_ method params)
                       (when slopchat-codex-request-observer (funcall slopchat-codex-request-observer method params))
                       '(:thread (:id "summary"))))
                    ((symbol-function 'slopchat-codex-async)
                     (lambda (_ method params callback)
                       (when slopchat-codex-request-observer (funcall slopchat-codex-request-observer method params))
                       (when (equal method "turn/start") (push callback callbacks))))
                    ((symbol-function 'slopchat-codex-forget-thread) #'ignore))
            (slopchat-schedule chat)
            (dotimes (i 2)
              (let* ((run (gethash "summary" (slopchat-connection-runs connection)))
                     (id (format "turn-%d" i)))
                (funcall (pop callbacks) (list :result (list :turn (list :id id))))
                (slopchat-codex--usage connection run
                  (list :threadId "summary" :turnId id :tokenUsage
                        (list :last '(:inputTokens 10 :cachedInputTokens 8)
                              :total (list :inputTokens (* (1+ i) 10) :cachedInputTokens (* (1+ i) 8)))))
                (setf (slopchat-run-replies run)
                      (list (if (= i 0) "echo: No entries." "echo: Result: 1 entries; 1 summaries unavailable.")))
                (slopchat-codex--finish run))))
          (let* ((entries (slopchat-context-store-entries (slopchat-chat-context chat)))
                 (latest (car entries)) (first (cadr entries))
                 (event (cl-find 'summary-validation (plist-get first :events) :key (lambda (e) (plist-get e :kind)))))
            (should (= (length entries) 2))
            (should (eq (plist-get event :state) 'rejected))
            (should (eq (plist-get event :scope) 'source-boundary))
            (should (stringp (plist-get event :reason)))
            (should (equal (plist-get event :response) "echo: No entries."))
            (should (eq (plist-get (cl-find 'summary-validation (plist-get latest :events) :key (lambda (e) (plist-get e :kind))) :state) 'passed))
            (should (equal (plist-get (slopchat-node chat '(0 0)) :text) "echo: Result: 1 entries; 1 summaries unavailable."))
            (should (= (slopchat-memory-usage-started (slopchat-memory-usage-ledger chat)) 2))
            (should (= (slopchat-memory-usage-input (slopchat-memory-usage-ledger chat)) 20))
            (should (= (slopchat-memory-usage-cached-input (slopchat-memory-usage-ledger chat)) 16))))
      (slopchat-close chat)
      (delete-directory directory t))))

(provide 'slopchat-fidelity-test)
