;;; slopchat-memory-compat.el --- White-box aliases for pre-extraction regressions -*- lexical-binding: t -*-
;; Not loaded by the application or by standalone memory users.
(require 'slopchat)
(require 'slopchat-context)
(dolist (field '(lock count messages nodes cursor view comp-view batching comp-batching jobs leaves leaf-slots states failed active))
  (let ((old (intern (format "slopchat-chat-%s" field)))
        (new (intern (format "unii-memory--state-%s" field))))
    (fset old (lambda (chat) (funcall new (slopchat-chat-memory chat))))
    (eval `(gv-define-setter ,old (value chat) `(setf (,',new (slopchat-chat-memory ,chat)) ,value)) t)))
(defun slopchat-chat-context (chat) (unii-memory--state-diagnostics (slopchat-chat-memory chat)))
(gv-define-setter slopchat-chat-context (value chat)
  `(setf (unii-memory--state-diagnostics (slopchat-chat-memory ,chat)) ,value))
(defun slopchat-memory-usage-ledger (chat) (unii-memory--state-ledger (slopchat-chat-memory chat)))

;; Retain structural unit regressions while app callers use only the public API.
(defun slopchat-test-refresh-policy (chat &rest _)
  (setf (unii-memory--state-policy (slopchat-chat-memory chat)) (slopchat-memory-policy)))
(advice-add 'slopchat-log :before #'slopchat-test-refresh-policy)
(dolist (name '(node source build render view-size merge-to checkpoint --publish --shrink --offer --validate-view))
  (let* ((suffix (symbol-name name))
         (old (intern (concat (if (string-prefix-p "--" suffix) "slopchat" "slopchat-") suffix)))
         (new (intern (concat "unii-memory--" (string-remove-prefix "--" suffix)))))
    (fset old (lambda (chat &rest args)
                (slopchat-test-refresh-policy chat)
                (unii-memory--with-policy (slopchat-chat-memory chat)
                  (apply new (slopchat-chat-memory chat) args))))))
(defalias 'slopchat-range #'unii-memory--range)
(defalias 'slopchat--write #'unii-memory--write)
(defalias 'slopchat--atomic #'unii-memory--atomic)
(defalias 'slopchat-best-merge #'unii-memory--best-merge)
(defun slopchat--prefix (_chat view end) (unii-memory--prefix view end))
(defun slopchat--context-view (chat key)
  (let* ((range (unii-memory--range key)) (end (if (= (car key) 0) (car range) (+ (car range) (cdr range)))))
    (unii-memory--prefix (slopchat-chat-comp-view chat) (min end (slopchat-chat-cursor chat)))))
(defun slopchat--context (chat key) (slopchat-render chat (slopchat--context-view chat key)))
(defun slopchat-zoom (chat id n &optional page) (unii-memory-zoom (slopchat-chat-memory chat) id n :page page))
(defun slopchat-date (chat id) (unii-memory-date (slopchat-chat-memory chat) id))

(put 'slopchat-queue-head 'compiler-macro nil)
(defalias 'slopchat-test--queue-head (symbol-function 'slopchat-queue-head))
(defun slopchat-queue-head (queue)
  (if (unii-memory--queue-p queue) (unii-memory--queue-head queue) (slopchat-test--queue-head queue)))

(dolist (pair '((slopchat-memory-usage--epochs . unii-memory--usage--epochs)
                (slopchat-memory-usage--ledgers . unii-memory--usage--ledgers)
                (slopchat-memory-usage--cache . unii-memory--usage--cache)))
  (defvaralias (car pair) (cdr pair)))
(dolist (suffix '(create start observe project retire observe-total cached-input cached-input-observed cache-write-input cache-write-input-observed
                 input output started input-observed output-observed attempts))
  (let ((old (intern (concat "slopchat-memory-usage-" (symbol-name suffix))))
        (new (intern (concat "unii-memory--usage-" (symbol-name suffix)))))
    (defalias old new)))
(provide 'slopchat-memory-compat)
